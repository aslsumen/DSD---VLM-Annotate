{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "VLM Annotate export (OpenLABEL profile)",
  "type": "object",
  "required": ["openlabel"],
  "properties": {
    "openlabel": {
      "type": "object",
      "required": ["metadata", "streams", "actions"],
      "properties": {
        "metadata": {
          "type": "object",
          "required": ["schema_version", "exported_at", "reviewer", "model", "dataset", "time_unit"],
          "properties": {
            "schema_version": { "const": "1.0.0" },
            "name": { "type": "string" },
            "exported_at": { "type": "string", "format": "date-time" },
            "reviewer": { "type": "string", "minLength": 1 },
            "model": { "type": "string", "minLength": 1 },
            "dataset": { "type": "string", "minLength": 1 },
            "time_unit": { "const": "seconds" }
          }
        },
        "streams": {
          "type": "object",
          "minProperties": 1,
          "additionalProperties": {
            "type": "object",
            "required": ["type", "uri"],
            "properties": {
              "type": { "type": "string" },
              "uri": { "type": "string", "minLength": 1 },
              "description": { "type": "string" }
            }
          }
        },
        "actions": {
          "type": "object",
          "minProperties": 1,
          "additionalProperties": {
            "type": "object",
            "required": ["type", "attributes"],
            "properties": {
              "name": { "type": "string" },
              "type": { "type": "string", "minLength": 1 },
              "stream": { "type": "string" },
              "attributes": {
                "type": "object",
                "required": ["num", "text", "boolean"],
                "properties": {
                  "num": {
                    "type": "array",
                    "items": { "$ref": "#/$defs/namedVal" },
                    "allOf": [
                      { "contains": { "type": "object", "required": ["name", "val"], "properties": { "name": { "const": "t_start_s" }, "val": { "type": "number" } } } },
                      { "contains": { "type": "object", "required": ["name", "val"], "properties": { "name": { "const": "t_end_s" }, "val": { "type": "number" } } } },
                      { "contains": { "type": "object", "required": ["name", "val"], "properties": { "name": { "const": "original_t_start_s" }, "val": { "type": "number" } } } },
                      { "contains": { "type": "object", "required": ["name", "val"], "properties": { "name": { "const": "original_t_end_s" }, "val": { "type": "number" } } } },
                      { "contains": { "type": "object", "required": ["name", "val"], "properties": { "name": { "const": "score" }, "val": { "type": "number", "minimum": 0, "maximum": 1 } } } }
                    ]
                  },
                  "text": {
                    "type": "array",
                    "items": { "$ref": "#/$defs/namedVal" },
                    "allOf": [
                      { "contains": { "type": "object", "required": ["name", "val"], "properties": { "name": { "const": "prompt" }, "val": { "type": "string", "minLength": 1 } } } },
                      { "contains": { "type": "object", "required": ["name", "val"], "properties": { "name": { "const": "review_status" }, "val": { "enum": ["accepted", "rejected", "unreviewed"] } } } }
                    ]
                  },
                  "boolean": {
                    "type": "array",
                    "items": { "$ref": "#/$defs/namedVal" },
                    "allOf": [
                      { "contains": { "type": "object", "required": ["name", "val"], "properties": { "name": { "const": "score_calibrated" }, "val": { "type": "boolean" } } } }
                    ]
                  }
                }
              }
            }
          }
        }
      }
    }
  },
  "$defs": {
    "namedVal": {
      "type": "object",
      "required": ["name", "val"],
      "properties": {
        "name": { "type": "string" }
      }
    }
  }
}
