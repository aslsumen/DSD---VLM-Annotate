# VLM Annotate — local configuration template.
# Copy to .env and adjust. NEVER commit .env (it is git-ignored).

# --- paths ---------------------------------------------------------------
# VLM_DATA_DIR=./data
# VLM_DATABASE_URL=sqlite:///./data/vlm_annotate.db

# --- access control ------------------------------------------------------
# When set, every /api/v1 route except /health requires:
#   Authorization: Bearer <token>
# Leave empty for local development.
VLM_API_TOKEN=

# --- Sprint 3 session auth (optional) ------------------------------------
# When true, the new /api/v1/auth and /api/v1/datasets routes require a
# session token. Existing project routes still use VLM_API_TOKEN above.
# VLM_AUTH_REQUIRED=false
# One-time secret for POST /api/v1/auth/bootstrap (first administrator only).
# VLM_BOOTSTRAP_TOKEN=
# VLM_AUTH_SESSION_HOURS=12
# VLM_AUTH_INVITATION_HOURS=48
# VLM_AUTH_MAX_FAILED_LOGINS=5
# VLM_AUTH_LOCKOUT_MINUTES=15

# --- upload limits -------------------------------------------------------
# VLM_MAX_UPLOAD_BYTES=2147483648
# VLM_MAX_VIDEO_DURATION_SECONDS=14400
# VLM_MIN_VIDEO_DURATION_SECONDS=1

# --- candidate proposal --------------------------------------------------
# VLM_VLM_ADAPTER=mock
# VLM_MAX_CANDIDATES_PER_JOB=12
# VLM_CANDIDATE_MIN_DURATION_SECONDS=1.5
# VLM_CANDIDATE_MAX_DURATION_SECONDS=40
# VLM_CLIP_PADDING_SECONDS=1.0
# VLM_CLIP_MAX_DURATION_SECONDS=90

# --- worker --------------------------------------------------------------
# VLM_WORKER_MAX_ATTEMPTS=3
# VLM_WORKER_RETRY_BACKOFF_SECONDS=5
# VLM_WORKER_POLL_INTERVAL_SECONDS=1.0
# VLM_FFMPEG_BINARY=

# --- frontend dev --------------------------------------------------------
# VLM_CORS_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173"]
